{
  "name": "imstage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node tools/dev-web.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4417 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "dev:web": "vite --host 127.0.0.1 --port 4417 --strictPort",
    "dev:api": "node services/api/server.mjs",
    "dev:mcp": "npm run build:mcp && node services/mcp/server.mjs",
    "start": "node tools/start-web.mjs",
    "test:eval": "node --test tools/eval/test/*.test.mjs",
    "test:mcp": "node --test tests/mcp*.test.mjs",
    "test:timeline": "node --test tests/timeline.test.mjs && node tools/eval/timeline.mjs",
    "build:mcp": "node services/mcp/build-studio.mjs",
    "pretest:mcp": "npm run build:mcp",
    "pretest": "npm run build:mcp"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tabler/icons-react": "3.47.0",
    "express": "5.2.1",
    "html-to-image": "1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "workspaces": [
    "tools/eval"
  ]
}
